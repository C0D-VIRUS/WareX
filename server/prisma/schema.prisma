generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockTransactionType {
  RECEIPT
  RESERVATION
  PICK
  PACK
  SHIP
  RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  RESERVED
  DELAYED
  PICKING
  PACKED
  PROCESSED
  SHIPPED
  DELIVERED
  CLOSED
}

enum ShipmentStatus {
  CREATED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CLOSED
}

enum RestockStatus {
  SUBMITTED
  VALIDATED
  REJECTED
  RECEIVED
  ACCEPTED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum DeliveryRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum ServiceStatus {
  ASSIGNED
  VISIT_ACCEPTED
  INSPECTED
  ASSEMBLY_COMPLETED
  DEFECT_FOUND
  REPAIR_COMPLETED
  COMPLETED
}

enum NotificationType {
  ORDER
  INVENTORY
  SHIPMENT
  DELIVERY
  RESTOCK
  COMPLAINT
  SERVICE
  SYSTEM
}

model Role {
  id          String   @id
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  fullName          String
  email             String            @unique
  phone             String?
  passwordHash      String
  status            UserStatus        @default(ACTIVE)
  isMainAdmin       Boolean           @default(false)
  roleId            String
  role              Role              @relation(fields: [roleId], references: [id])
  warehousesManaged Warehouse[]       @relation("WarehouseManager")
  createdTransfers  WarehouseTransfer[] @relation("TransferCreator")
  orders            Order[]           @relation("CustomerOrders")
  restockShipments  RestockShipment[] @relation("DealerRestocks")
  deliveryRuns      DeliveryRun[]     @relation("DeliveryPartnerRuns")
  shipments         Shipment[]        @relation("DeliveryPartnerShipments")
  complaints        Complaint[]       @relation("CustomerComplaints")
  returnRequests    ReturnRequest[]   @relation("CustomerReturns")
  serviceVisits     ServiceVisit[]    @relation("TechnicianVisits")
  notifications     Notification[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([roleId])
  @@index([status])
}

model Warehouse {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  city              String
  address           String?
  capacity          Int
  status            String             @default("ACTIVE")
  managerId         String?            @db.Uuid
  manager           User?              @relation("WarehouseManager", fields: [managerId], references: [id])
  rackBins          RackBin[]
  inventories       Inventory[]
  stockTransactions StockTransaction[]
  orders            Order[]
  restocks          RestockShipment[]
  outgoingTransfers WarehouseTransfer[] @relation("TransferOrigin")
  incomingTransfers WarehouseTransfer[] @relation("TransferDestination")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([managerId])
}

model RackBin {
  id           String      @id @default(uuid()) @db.Uuid
  locationCode String      @unique
  rackCode     String
  binCode      String
  capacity     Int
  warehouseId  String      @db.Uuid
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventories  Inventory[]
  createdAt    DateTime    @default(now())

  @@index([warehouseId])
}

model SKU {
  id                String             @id @default(uuid()) @db.Uuid
  sku               String             @unique
  name              String
  category          String
  unitPrice         Decimal            @db.Decimal(12, 2)
  cartonSize        Int                @default(1)
  requiresAssembly  Boolean            @default(false)
  reorderThreshold  Int                @default(0)
  isActive          Boolean            @default(true)
  inventories       Inventory[]
  stockTransactions StockTransaction[]
  restockItems      RestockItem[]
  transferItems     WarehouseTransferItem[]
  orderItems        OrderItem[]
  returnRequests    ReturnRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([category])
  @@index([isActive])
}

model Inventory {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  skuId       String    @db.Uuid
  rackBinId   String?   @db.Uuid
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  incoming    Int       @default(0)
  lastUpdated DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sku         SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  rackBin     RackBin?  @relation(fields: [rackBinId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, skuId])
  @@index([skuId])
  @@index([warehouseId])
}

model WarehouseTransfer {
  id              String               @id @default(uuid()) @db.Uuid
  transferId      String               @unique
  status          TransferStatus       @default(REQUESTED)
  fromWarehouseId String               @db.Uuid
  toWarehouseId   String               @db.Uuid
  createdById     String               @db.Uuid
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  fromWarehouse   Warehouse            @relation("TransferOrigin", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse            @relation("TransferDestination", fields: [toWarehouseId], references: [id])
  createdBy       User                 @relation("TransferCreator", fields: [createdById], references: [id])
  items           WarehouseTransferItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@index([status])
}

model WarehouseTransferItem {
  id                 String            @id @default(uuid()) @db.Uuid
  transferId         String            @db.Uuid
  skuId              String            @db.Uuid
  quantity           Int
  receivedQuantity   Int               @default(0)
  transfer           WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku                SKU               @relation(fields: [skuId], references: [id])

  @@unique([transferId, skuId])
  @@index([skuId])
}

model StockTransaction {
  id              String               @id @default(uuid()) @db.Uuid
  transactionId   String               @unique @default(uuid()) @db.Uuid
  type            StockTransactionType
  quantity        Int
  transactionDate DateTime             @default(now())
  referenceNo     String?
  note            String?
  warehouseId     String               @db.Uuid
  skuId           String               @db.Uuid
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sku             SKU                  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([warehouseId, skuId])
  @@index([transactionDate])
}

model RestockShipment {
  id                String        @id @default(uuid()) @db.Uuid
  restockId         String        @unique
  shipmentDate      DateTime      @default(now())
  status            RestockStatus @default(SUBMITTED)
  policyNote        String?
  documentReference String?
  dealerId          String        @db.Uuid
  destinationId     String        @db.Uuid
  dealer            User          @relation("DealerRestocks", fields: [dealerId], references: [id])
  destination       Warehouse     @relation(fields: [destinationId], references: [id])
  items             RestockItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([dealerId])
  @@index([destinationId])
  @@index([status])
}

model RestockItem {
  id                String          @id @default(uuid()) @db.Uuid
  restockShipmentId String          @db.Uuid
  skuId             String          @db.Uuid
  quantity          Int
  acceptedQuantity  Int             @default(0)
  restockShipment   RestockShipment @relation(fields: [restockShipmentId], references: [id], onDelete: Cascade)
  sku               SKU             @relation(fields: [skuId], references: [id])

  @@index([restockShipmentId])
  @@index([skuId])
}

model Order {
  id             String          @id @default(uuid()) @db.Uuid
  orderNumber    String          @unique
  orderDate      DateTime        @default(now())
  status         OrderStatus     @default(PLACED)
  totalAmount    Decimal         @db.Decimal(14, 2)
  dispatchCutoff DateTime?
  customerId     String          @db.Uuid
  warehouseId    String          @db.Uuid
  customer       User            @relation("CustomerOrders", fields: [customerId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  items          OrderItem[]
  shipment       Shipment?
  complaints     Complaint[]
  returnRequests ReturnRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  skuId     String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       SKU     @relation(fields: [skuId], references: [id])

  @@unique([orderId, skuId])
  @@index([skuId])
}

model Shipment {
  id                String           @id @default(uuid()) @db.Uuid
  shipmentNumber    String           @unique
  trackingNumber    String?          @unique
  shipmentDate      DateTime?
  status            ShipmentStatus   @default(CREATED)
  eta               DateTime?
  orderId              String           @unique @db.Uuid
  deliveryPartnerId    String?          @db.Uuid
  deliveryRunId        String?          @db.Uuid
  packageWeightKg      Float?
  packageLengthCm      Float?
  packageWidthCm       Float?
  packageHeightCm      Float?
  estimatedDistanceKm  Float?
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner   User?            @relation("DeliveryPartnerShipments", fields: [deliveryPartnerId], references: [id])
  deliveryRun       DeliveryRun?     @relation(fields: [deliveryRunId], references: [id])
  proofOfDelivery   ProofOfDelivery?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([deliveryPartnerId])
  @@index([deliveryRunId])
  @@index([status])
}

model DeliveryRun {
  id                String            @id @default(uuid()) @db.Uuid
  runId             String            @unique
  runDate           DateTime          @default(now())
  route             String
  status            DeliveryRunStatus @default(PLANNED)
  vehicleId         String?           @db.Uuid
  deliveryPartnerId String?           @db.Uuid
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id])
  deliveryPartner   User?             @relation("DeliveryPartnerRuns", fields: [deliveryPartnerId], references: [id])
  shipments         Shipment[]
  createdAt         DateTime          @default(now())

  @@index([vehicleId])
  @@index([deliveryPartnerId])
  @@index([status])
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  registrationNo String        @unique
  vehicleType    String
  capacity             Int
  maxWeightKg          Float           @default(1000)
  maxLengthCm          Float           @default(300)
  maxWidthCm           Float           @default(160)
  maxHeightCm          Float           @default(160)
  operatingCostPerKm   Float           @default(12)
  energyUsePerKm       Float           @default(0.18)
  averageSpeedKmph     Float           @default(35)
  status               VehicleStatus  @default(AVAILABLE)
  deliveryRuns         DeliveryRun[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Complaint {
  id            String          @id @default(uuid()) @db.Uuid
  complaintId   String          @unique
  complaintDate DateTime        @default(now())
  complaintType String
  description   String
  status        ComplaintStatus @default(OPEN)
  priority      String          @default("NORMAL")
  customerId    String          @db.Uuid
  orderId       String?         @db.Uuid
  customer      User            @relation("CustomerComplaints", fields: [customerId], references: [id])
  order         Order?          @relation(fields: [orderId], references: [id])
  serviceVisit  ServiceVisit?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model ReturnRequest {
  id               String       @id @default(uuid()) @db.Uuid
  returnId         String       @unique
  requestDate      DateTime     @default(now())
  reason           String
  status           ReturnStatus @default(REQUESTED)
  inspectionResult String?
  customerId       String       @db.Uuid
  orderId          String       @db.Uuid
  skuId            String?      @db.Uuid
  customer         User         @relation("CustomerReturns", fields: [customerId], references: [id])
  order            Order        @relation(fields: [orderId], references: [id])
  sku              SKU?         @relation(fields: [skuId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  notificationId String           @unique
  type           NotificationType @default(SYSTEM)
  message        String
  readStatus     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  recipientId    String           @db.Uuid
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readStatus])
  @@index([createdAt])
}

model ProofOfDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  podId      String   @unique
  podType    String
  capturedAt DateTime @default(now())
  reference  String?
  notes      String?
  shipmentId String   @unique @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ServiceVisit {
  id               String        @id @default(uuid()) @db.Uuid
  visitId          String        @unique
  scheduledDate    DateTime?
  visitType        String
  status           ServiceStatus @default(ASSIGNED)
  notes            String?
  assemblyRequired Boolean       @default(false)
  defectFound      Boolean       @default(false)
  completedAt      DateTime?
  complaintId      String        @unique @db.Uuid
  technicianId     String        @db.Uuid
  complaint        Complaint     @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  technician       User          @relation("TechnicianVisits", fields: [technicianId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([technicianId])
  @@index([status])
}
